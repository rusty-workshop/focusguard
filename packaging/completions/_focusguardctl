#compdef focusguardctl
# Zsh completion for focusguardctl.
#
# Manual install: copy to a directory in $fpath (e.g. ~/.zsh/completions,
# with `fpath+=~/.zsh/completions` before `compinit` in ~/.zshrc), or to
# /usr/share/zsh/site-functions/_focusguardctl (done automatically by the
# PKGBUILD).

_focusguardctl_profiles() {
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/focusguard/config.json"
    [[ -r "$cfg" ]] || return
    (( $+commands[jq] )) || return
    jq -r '.profiles | keys[]?' "$cfg" 2>/dev/null
}

_focusguardctl() {
    local -a commands
    commands=(
        'status:show current blocking state'
        'start:manually start a profile now'
        'stop:stop the active block'
        'pause:pause all enforcement for N minutes'
        'resume:cancel an active pause immediately'
        'toggle:start profile if inactive, stop it if active'
        'reload:force the daemon to reload config.json'
        'doctor:check daemon/socket/systemd/config health'
        'vigi:say hi to Vigi'
    )

    if (( CURRENT == 2 )); then
        _describe 'command' commands
        return
    fi

    case "${words[2]}" in
        start|toggle|stop)
            if (( CURRENT == 3 )); then
                local -a profiles
                profiles=(${(f)"$(_focusguardctl_profiles)"})
                _describe 'profile' profiles
                return
            fi
            ;;
    esac

    _arguments '--json[machine-readable JSON output]'
}

_focusguardctl "$@"
