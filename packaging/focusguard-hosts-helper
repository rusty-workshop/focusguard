#!/usr/bin/env python3
"""Root-run helper: applies FocusGuard's managed website-block list to
/etc/hosts. This is the ONLY piece of FocusGuard that runs as root, and it
does exactly one narrow thing.

Usage:
    focusguard-hosts-helper <domain-list-file>

<domain-list-file> is a plain text file, one already-normalized domain per
line (blank lines ignored). Every domain is re-validated here regardless of
what the caller claims -- this script is reachable via a passwordless sudo
rule, so it must never trust its input.

An empty file removes FocusGuard's managed block from /etc/hosts entirely.

The target path defaults to /etc/hosts and can be overridden with the
FOCUSGUARD_HOSTS_PATH environment variable, which exists solely so tests can
point this at a throwaway file instead of the real system hosts file.
"""
from __future__ import annotations

import os
import sys
import tempfile

# Installed alongside the focusguard package (see PKGBUILD), so this import
# works when run as root without needing a venv.
from focusguard.common.domains import InvalidDomainError, validate_domain
from focusguard.daemon.hosts import merge_into_hosts


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(f"usage: {argv[0]} <domain-list-file>", file=sys.stderr)
        return 2

    list_path = argv[1]
    try:
        with open(list_path, "r", encoding="utf-8") as f:
            raw_lines = [line.strip() for line in f]
    except OSError as exc:
        print(f"error: could not read {list_path}: {exc}", file=sys.stderr)
        return 1

    domains = [line for line in raw_lines if line]
    try:
        for domain in domains:
            validate_domain(domain)
    except InvalidDomainError as exc:
        print(f"error: refusing malformed domain: {exc}", file=sys.stderr)
        return 1

    hosts_path = os.environ.get("FOCUSGUARD_HOSTS_PATH", "/etc/hosts")
    try:
        with open(hosts_path, "r", encoding="utf-8") as f:
            original = f.read()
    except OSError as exc:
        print(f"error: could not read {hosts_path}: {exc}", file=sys.stderr)
        return 1

    try:
        updated = merge_into_hosts(original, domains)
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1

    if updated == original:
        return 0

    directory = os.path.dirname(hosts_path) or "."
    fd, tmp_path = tempfile.mkstemp(prefix=".hosts-", suffix=".tmp", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(updated)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp_path, 0o644)
        os.replace(tmp_path, hosts_path)
    except OSError as exc:
        if os.path.exists(tmp_path):
            os.unlink(tmp_path)
        print(f"error: could not write {hosts_path}: {exc}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
