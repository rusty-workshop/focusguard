[Unit]
Description=FocusGuard app-blocker enforcement daemon
After=graphical-session.target

[Service]
Type=simple
# Bare command name: resolved via the system search path (/usr/bin etc.),
# which is where the PKGBUILD/system install puts it. If you installed with
# `pip install --user .` instead, replace this with the absolute path from
# `which focusguardd` (typically %h/.local/bin/focusguardd).
ExecStart=focusguardd
Restart=on-failure
RestartSec=2
# NoNewPrivileges=yes was set here as defense-in-depth before website
# blocking existed. It can't be kept: it blocks *any* privilege escalation
# via execve (sudo, setuid, pkexec -- doesn't matter which), and website
# blocking's entire design is the daemon calling `sudo -n` to run one
# narrowly-scoped, self-validating helper (see packaging/focusguard-hosts-
# helper and the "Website blocking" section of the README). The sudoers
# drop-in is the security boundary now: it grants NOPASSWD for exactly one
# script at one path, nothing else, to `wheel` members only.

[Install]
WantedBy=default.target
